{
  "name": "reedance-studio",
  "version": "1.0.8",
  "private": true,
  "description": "Reedance Content Studio - Electron desktop app to import AI drafts, sync lyrics on a waveform timeline, review, and export encrypted .rdpack bundles.",
  "author": {
    "name": "HYDRO team",
    "email": "khodehydro@gmail.com"
  },
  "license": "UNLICENSED",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "fixture": "node scripts/make-test-fixture.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux dir --publish never"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fflate": "^0.8.3",
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
}
